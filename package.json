{
  "name": "coresearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3780",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3780",
    "coresearch": "tsx scripts/coresearch.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test tests/profile.test.ts tests/profile-draft.test.ts tests/targets.test.ts tests/target-draft.test.ts tests/installation.test.ts tests/workspace.test.ts tests/style.test.ts tests/quote.test.ts tests/openalex.test.ts tests/research.test.ts tests/outreach.test.ts tests/cli.test.ts",
    "test:app": "node --import tsx --test tests/app.test.ts",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "next": "16.4.2",
    "node-html-parser": "9.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "1.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jiti": "2.7.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "@radix-ui/react-navigation-menu": "1.2.14"
  }
}
